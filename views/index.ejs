<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OAK Weight Inventory</title>
</head>
<body>
    <div class="app">
        <div class="header">
            <h1>Current Inventory</h1>
            <a href="/new">Add New Weight</a>
        </div>
        <div class="inventory-container">
            <% weights.forEach(weight => { %>
            <div class="weight-card">
                <p><%= weight.weight_id %></p>
                <p><%= weight.weight %></p>
                <p><%= weight.price %></p>
                <p><%= weight.quantity %></p>
                <img src="/images/<%= weight.weight %>.jpg" alt="<%= weight.weight %> lb plate"
                    onerror="this.onerror=null; this.src='/default.jpg'">
                <small>Made by <%= weight.manufacturer_name %> Using <%= weight.material_name %></small>
                <a class="card-link" href="/<%= weight.weight_id %>">EDIT</a>
                <hr>
            </div>
            <% }) %>
        </div>
    </div>
</body>
</html>