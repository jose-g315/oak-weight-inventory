<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Materials</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <div class="app">
        <div class="header">
            <h1>Current Materials</h1>
            <div>
                <a href="/" class="header-link">Go Back</a>
            </div>
        </div>
        <a href="/materials/new" class="header-link add-link">Add Material</a>
        <div class="card-container">
            <% materials.forEach(material => { %>
            <div class="card">
                <p>Material Name: <span><%= material.name%></span></p>
                <a class="card-link" href="/materials/<%= material.material_id %>/update">Edit</a>
            </div>
            <% }) %>
        </div>
        <%- include ('../partials/footer') %>
    </div>
</body>
</html>