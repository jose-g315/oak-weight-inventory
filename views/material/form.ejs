<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Material Form</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <div class="app">
        <% const m = locals.material || {}; const isEdit = Boolean(m.material_id); %>
        <div class="header">
            <h1><%= isEdit ? 'Update' : 'Add New' %> Material</h1>
            <div>
                <a href="/materials" class="header-link">Go Back</a>
                <a href="/" class="header-link">Home</a>
            </div>
        </div>
          <h2 class="current-selected">Current Name: <span><%= isEdit ?  m.name: '' %></span></h2>
            <%- include("../partials/errorPartial") %>
            <form method="POST" action="<%= isEdit ? `/materials/${m.material_id}/update` : '/materials/new' %>">
                <label for="name">Material Name:</label>
                <input type="text" id="name" name="name" value="<%= input?.name || '' %>" required>
                <button type="submit"><%= isEdit ? 'Update' : 'Create' %></button>
            </form>

            <% if (isEdit) { %>
                <form class="delete-form" method="POST" action="/materials/<%= m.material_id %>/delete" onsubmit="return confirm('Delete this material?')"> 
                    <button type="submit">Delete Material</button> 
                </form>
            <% } %>
            <%- include ('../partials/footer') %>
    </div>
</body>
</html>