<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OAK Weight Inventory</title>
</head>
<body>
    <div class="app">
        <div class="header">
            <h1>Current Manufacturers</h1>
            <a href="/">Go Back</a>
            <a href="/manufacturers/new">Add Manufacturer</a>

        </div>
        <div class="inventory-container">
            <% manufacturers.forEach(manufacturer => { %>
            <div class="manufacturer-card">
                <p><%= manufacturer.manufacturer_id %></p>
                <p><%= manufacturer.name%></p>
                <a class="card-link" href="/manufacturers/<%= manufacturer.manufacturer_id %>/update">Edit Manufacturer</a>
                <hr>
            </div>
            <% }) %>
        </div>
    </div>
</body>
</html>