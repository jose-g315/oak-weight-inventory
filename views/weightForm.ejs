<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Weight Form</title>
    <link rel="stylesheet" href="styles/styles.css">
</head>
<body>
    <div class="app">
    <% const values = locals.values || {} %>
        <div class="header">
             <h1>Add New Weight</h1>
            <a href="/" class="header-link">Go Back</a>
        </div>
        <%- include("./partials/errorPartial") %>
        <form method="POST" action="/new" >
            <h2>Weight Form</h2>
            <div>
                <label for="weight">Weight:</label>
                <select id="weight" name="weight" required>
                    <optgroup label="Pounds">
                    <% [5, 10, 25, 35, 45, 100].forEach(w => { %>
                        <option value="<%= w %>" <%= String(w) === String(values.weight) ? 'selected' : '' %>>
                            <%= w %>
                        </option>
                    <% }) %>
                    </optgroup>
                </select>
            </div>
            <div>
                <label for="price">Price ($):</label>
                <input type="number" id="price" name="price" step="0.01" min="0" required value="<%= values.price ?? '' %>">
            </div>
            <div>
                <label for="quantity">Quantity:</label>
                <input type="number" id="quantity" name="quantity" min="0" required value="<%= values.quantity ?? '' %>">
            </div>
            <div>
                <label for="manufacturer_id">Manufacturer:</label>
                <select id="manufacturer_id" name="manufacturer_id">
                    <% manufacturers.forEach(manufacturer => { %>
                    <option value="<%= manufacturer.manufacturer_id %>"
                        <%= String(manufacturer.manufacturer_id) === String(values.manufacturer_id) ? 'selected' : '' %>>
                        <%= manufacturer.name %>
                    </option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label for="material_id">Material:</label>
                <select id="material_id" name="material_id">
                    <% materials.forEach(material => { %>
                    <option value="<%= material.material_id %>"
                        <%= String(material.material_id) === String(values.material_id) ? 'selected' : '' %>>
                        <%= material.name %>
                    </option>
                    <% }) %>
                </select>
            </div>
            <button type="submit">Create</button>
        </form>
        <%- include ('partials/footer') %>
    </div>
</body>
</html>